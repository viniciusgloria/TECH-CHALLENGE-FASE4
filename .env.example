# Copie para .env e ajuste. O .env não vai para o Git.

# claude_cli: usa o Claude Code instalado (login da assinatura, sem chave de API)
# openrouter: usa uma chave do OpenRouter, para quem não tem o Claude Code
# manual: só monta o prompt e salva em reports/prompts/, sem chamar modelo
LLM_BACKEND=claude_cli

# Onde gravar o índice do Chroma. Deixe vazio para usar data/index.
# No Windows, se o projeto estiver numa pasta com acento no caminho, use um caminho ASCII (ex.: C:\fase4_index).
INDEX_DIR=

# claude_cli: sonnet ou opus
CLAUDE_MODELO=sonnet

# openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
